{
  "name": "onegate",
  "version": "0.1.0",
  "description": "Open-source credential gateway for AI agents: a TLS-terminating proxy that injects vendor credentials, with per-agent permissions, projects, audit log and a web UI.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "bin": {
    "onegate": "./bin/onegate.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/admin && cp -r src/admin/ui dist/admin/",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.2.1",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/node-forge": "^1.3.14",
    "@vitest/coverage-v8": "^3.2.7",
    "simple-icons": "^16.27.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
