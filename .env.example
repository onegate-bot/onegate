# OneGate configuration. Copy to .env and adjust. All values are optional and
# have safe defaults. NEVER commit a real .env, tokens, keys, or CA material.

# --- Data and ports ---
# Directory for the data dir, root CA, admin token, and SQLite DB.
ONEGATE_DATA=~/.onegate
# HTTP CONNECT proxy port that agents point HTTPS_PROXY at.
ONEGATE_PROXY_PORT=8443
# Admin API + web UI port.
ONEGATE_ADMIN_PORT=8080
# Bind address. Leave unset to bind loopback only.
# ONEGATE_BIND=127.0.0.1
# Public base URL used to build connect links (e.g. https://app.example.com).
# ONEGATE_PUBLIC_URL=

# --- Security material (generated by `onegate init`, do not hand-set unless you know why) ---
# At-rest DB encryption key. If unset, OneGate manages it in the data dir.
# ONEGATE_DB_KEY=
# Paths to an externally-managed root CA. Leave unset to let OneGate mint one.
# ONEGATE_CA_CERT_FILE=
# ONEGATE_CA_KEY_FILE=
# Admin token override. Normally minted into the data dir by `onegate init`.
# ONEGATE_ADMIN_TOKEN=

# --- Behavior ---
# Comma-separated integrations to disable (return their hosts to opaque passthrough).
# ONEGATE_DISABLED_INTEGRATIONS=
# Directory for community (drop-in) integrations.
# ONEGATE_COMMUNITY_DIR=
# Max buffered request/response body in bytes for injection.
# ONEGATE_MAX_BUFFERED_BODY=
